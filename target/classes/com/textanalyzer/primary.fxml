<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="20" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.textanalyzer.PrimaryController"
      style="-fx-padding: 30;">
    
    <Label text="TEXT ANALYZER" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

    <VBox spacing="10" style="-fx-border-color: #ccc; -fx-padding: 15; -fx-border-radius: 5;">
        <Label text="Selected Files:" style="-fx-font-size: 16;"/>
        <ListView fx:id="fileListView" prefHeight="200"/>
    </VBox>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Load Files" fx:id="loadBtn" prefWidth="150" onAction="#onLoadFiles"/>
        <Button text="Start Analysis" fx:id="analyzeBtn" prefWidth="150" onAction="#onStartAnalysis"/>
    </HBox>

    <Label fx:id="statusLabel" text="Status: Waiting..."
           style="-fx-font-size: 14; -fx-text-fill: #333;"/>

</VBox>
