<?xml version="1.0"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.textanalyzer.controllers.SecondaryController"
      stylesheets="@styles.css"
      alignment="CENTER" spacing="20" style="-fx-padding: 30;">

    <Label text="ANALYSIS RESULTS" style="-fx-font-size: 22; -fx-font-weight: bold;"/>

    <TextArea fx:id="resultsArea" prefWidth="400" prefHeight="300"/>

    <Button text="Back to Home" onAction="#onBack"/>
</VBox>
